# Example environment variables for the Notes App
# Copy this file to `.env` and fill in real values before running.

# Backend
MONGO_URI=mongodb://<username>:<password>@<host>:<port>/<database>
PORT=5001
NODE_ENV=development

# Upstash / Redis (used by rate limiter)
# If you use Upstash, set these values (Redis.fromEnv reads them).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative Redis connection string (if not using Upstash)
# REDIS_URL=redis://<user>:<password>@<host>:<port>
